+// Some input paths can expose a no-timestamp sentinel in DEMUX_PACKET's double
+// fields with the opposite sign from DVD_NOPTS_VALUE. Comparing only with
+// DVD_NOPTS_VALUE therefore misclassifies it as a real timestamp. Do not let
+// such values take part in post-reset A/V alignment: they can create an enormous
+// correction that makes ActiveAE wait for audio forever.
+static bool IsValidRealtimeTimestamp(double timestamp)
+{
+  if (!std::isfinite(timestamp))
+    return false;
+
+  constexpr double noPtsLimit = static_cast<double>(DVD_NOPTS_VALUE) / 2.0;
+  return timestamp != static_cast<double>(DVD_NOPTS_VALUE) &&
+         std::abs(timestamp) < noPtsLimit;
+}
