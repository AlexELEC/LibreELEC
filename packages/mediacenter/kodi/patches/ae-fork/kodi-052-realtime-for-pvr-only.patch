+// TVLINK's enhanced recovery is for realtime PVR playback. When a PVR client
+// delegates demuxing to inputstream.ffmpegdirect, Kodi represents the input as
+// DVDSTREAM_TYPE_ADDON rather than DVDSTREAM_TYPE_PVRMANAGER. Require both a PVR
+// item and FFmpeg Direct for that case, so unrelated realtime add-ons such as
+// inputstream.adaptive (YouTube Live) do not enter this recovery path.
+static bool IsRealtimePVRStream(const std::shared_ptr<CDVDInputStream>& inputStream,
+                                const CFileItem& item)
+{
+  if (!inputStream || !inputStream->IsRealtime() || !item.IsPVR())
+    return false;
+
+  if (inputStream->IsStreamType(DVDSTREAM_TYPE_PVRMANAGER))
+    return true;
+
+  // PVR clients can delegate TS demuxing to FFmpeg Direct. In this case Kodi
+  // sees an ADDON input stream, so identify it by both the PVR item and add-on.
+  return inputStream->IsStreamType(DVDSTREAM_TYPE_ADDON) &&
+         item.GetProperty(STREAM_PROPERTY_INPUTSTREAM).asString() == "inputstream.ffmpegdirect";
+}
