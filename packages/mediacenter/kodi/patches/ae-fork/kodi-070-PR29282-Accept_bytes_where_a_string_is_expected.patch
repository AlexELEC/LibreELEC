From a7d4a5ed0fea3c97c96f61a0f025093e9e927ecd Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 11 Sep 2026 09:03:13 +0100
Subject: [PATCH] Accept bytes where a string is expected

The typecheck typemap for `const std::string&` offers the conversion str,
None and bytes, but the conversion takes only str: stock
SWIG_AsCharPtrAndSize tests PyBytes_Check in place of PyUnicode_Check, and
only when the binding is built for bytes throughout. So a call passing bytes
passes overload resolution and then fails to convert.

Add-ons hit this passing text that Python 3 hands back as bytes; a widely
used add-on module stores its window state as a protocol 0 pickle.

Decode as strict UTF-8 rather than copying across, since the value is read
back as a window property and shown by skins. Bytes are deprecated, as None
already is, and both log a warning.
---
 .../python/test/TestPythonBindings.cpp        | 36 +++++++++++++++++++
 xbmc/interfaces/swig/kodi_string.i            | 36 +++++++++++++++++--
 2 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/xbmc/interfaces/python/test/TestPythonBindings.cpp b/xbmc/interfaces/python/test/TestPythonBindings.cpp
index e7ffd1405ada3..f9196afce301d 100644
--- a/xbmc/interfaces/python/test/TestPythonBindings.cpp
+++ b/xbmc/interfaces/python/test/TestPythonBindings.cpp
@@ -134,6 +134,42 @@ li.getVideoInfoTag().setStudios(['a', None])
 )py"));
 }
 
+TEST_F(TestPythonBindings, BytesAsString)
+{
+  if (!s_pythonUp)
+    GTEST_SKIP() << "python runtime not initialized";
+  ASSERT_TRUE(s_mainImportOk);
+  EXPECT_TRUE(RunPy(R"py(
+import pickle
+import xbmcgui
+li = xbmcgui.ListItem('bytes-as-string', '', '', True)
+
+li.setProperty('ascii', b'plain')
+assert li.getProperty('ascii') == 'plain', repr(li.getProperty('ascii'))
+
+li.setProperty('utf8', 'caf\u00e9'.encode('utf-8'))
+assert li.getProperty('utf8') == 'caf\u00e9', repr(li.getProperty('utf8'))
+
+# What add-ons storing a pickle actually pass: protocol 0 is text, which
+# Python 3 hands back as bytes
+blob = pickle.dumps({'a': 1}, protocol=0)
+li.setProperty('pickle', blob)
+assert pickle.loads(li.getProperty('pickle').encode('utf-8')) == {'a': 1}
+
+# As a dict value, which goes through the same conversion
+li.setProperties({'alpha': '1', 'beta': b'two'})
+assert li.getProperty('beta') == 'two', repr(li.getProperty('beta'))
+
+# Bytes that are not text are refused rather than stored
+try:
+    li.setProperty('binary', b'\xff\xfe')
+except TypeError:
+    pass
+else:
+    raise AssertionError('binary bytes were accepted')
+)py"));
+}
+
 TEST_F(TestPythonBindings, FileContextManager)
 {
   if (!s_pythonUp)
diff --git a/xbmc/interfaces/swig/kodi_string.i b/xbmc/interfaces/swig/kodi_string.i
index 27708653bc48f..b08b88fde3459 100644
--- a/xbmc/interfaces/swig/kodi_string.i
+++ b/xbmc/interfaces/swig/kodi_string.i
@@ -10,8 +10,9 @@
 #include "utils/log.h"
 %}
 
-/* 'None' is accepted as the empty string, including as a dict value or list element. */
-//! @todo Drop the 'None' acceptance after v22; kodi_typing.i annotates these as str.
+/* 'None' is accepted as the empty string, and bytes as the text they decode to,
+   including as a dict value or list element. */
+//! @todo Drop 'None' and bytes after v22; addons pass '' or .decode() first
 %fragment(SWIG_AsVal_frag(std::string), "header", fragment=SWIG_AsPtr_frag(std::string)) {
 SWIGINTERN int
 SWIG_AsVal_dec(std::string)(SWIG_Object obj, std::string* val)
@@ -25,6 +26,37 @@ SWIG_AsVal_dec(std::string)(SWIG_Object obj, std::string* val)
     return SWIG_OK;
   }
 
+  /* Stock SWIG_AsCharPtrAndSize takes str only, while the typecheck typemap
+     below offers this conversion bytes as well. */
+  if (PyBytes_Check(obj))
+  {
+    CLog::Log(LOGWARNING, "Passing bytes where a string is expected is deprecated and will be "
+                          "removed in v23. Please .decode() the value first.");
+
+    PyObject* decoded = PyUnicode_FromEncodedObject(obj, "utf-8", "strict");
+    if (!decoded)
+    {
+      PyErr_Clear();
+      return SWIG_TypeError;
+    }
+
+    if (val)
+    {
+      Py_ssize_t size = 0;
+      const char* text = PyUnicode_AsUTF8AndSize(decoded, &size);
+      if (!text)
+      {
+        Py_DECREF(decoded);
+        PyErr_Clear();
+        return SWIG_TypeError;
+      }
+      val->assign(text, size);
+    }
+
+    Py_DECREF(decoded);
+    return SWIG_OK;
+  }
+
   std::string* v = 0;
   int res = SWIG_AsPtr(std::string)(obj, &v);
   if (!SWIG_IsOK(res))
