+      current.starttime = DVD_NOPTS_VALUE;
+      current.starttimePending = false;
+      current.cachetime = 0.0;
+      current.cachetotal = 0.0;
+      current.startpts = DVD_NOPTS_VALUE;
+      current.lastdts = DVD_NOPTS_VALUE;
+      current.avsync = CCurrentStream::AV_SYNC_FORCE;
+    };
+    resetTimeline(m_CurrentAudio);
+    resetTimeline(m_CurrentVideo);
+  }
