-bool CDVDDemuxClient::IsVideoReady()
+bool CDVDDemuxClient::IsVideoReady(bool requireVideoStream)
 {
+  if (requireVideoStream)
+  {
+    // During a realtime-PVR STREAMRESET, m_videoStreamPlaying can still refer
+    // to the previous layout. Do not interpret the absence of that old stream ID
+    // as proof that the replacement video is ready. Require an actual video in
+    // the refreshed map, and wait until required codec extradata has been parsed.
+    bool videoStreamFound = false;
+    for (const auto& stream : m_streams)
+    {
+      if (!stream.second || stream.second->type != StreamType::VIDEO)
+        continue;
+
+      videoStreamFound = true;
+      if (CodecHasExtraData(stream.second->codec) && !stream.second->extraData)
+        return false;
+    }
+    return videoStreamFound;
+  }
+
+  // Keep the established readiness rule for non-realtime-PVR paths.
   for (const auto& stream : m_streams)
   {
-    if (stream.first == m_videoStreamPlaying && stream.second->type == StreamType::VIDEO &&
-        CodecHasExtraData(stream.second->codec) && !stream.second->extraData)
+    if (stream.first == m_videoStreamPlaying && stream.second &&
+        stream.second->type == StreamType::VIDEO && CodecHasExtraData(stream.second->codec) &&
+        !stream.second->extraData)
       return false;
   }
   return true;
