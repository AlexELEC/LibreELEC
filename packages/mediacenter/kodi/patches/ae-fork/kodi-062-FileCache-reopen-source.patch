+bool CFileCache::ReopenSource()
+{
+  auto retryDelay = SOURCE_REOPEN_RETRY_DELAY;
+
+  for (unsigned int attempt = 1; attempt <= MAX_SOURCE_ATTEMPTS; ++attempt)
+  {
+    if (m_bStop)
+      return false;
+
+    CLog::Log(LOGWARNING,
+              "CFileCache::{} - reopening source at position {} (attempt {}/{}) <{}>",
+              __FUNCTION__, m_writePos, attempt, MAX_SOURCE_ATTEMPTS, m_sourcePath);
+
+    m_source.Close();
+
+    if (m_source.Open(m_sourceUrl, READ_NO_CACHE | READ_TRUNCATED | READ_NO_BUFFER))
+    {
+      m_seekPossible = m_source.IoControl(IOControl::SEEK_POSSIBLE, NULL);
+      if (m_seekPossible)
+      {
+        m_fileSize = m_source.GetLength();
+
+        const auto seekResult = m_source.Seek(m_writePos, SEEK_SET);
+        if (seekResult == m_writePos)
+        {
+          CLog::Log(LOGWARNING,
+                    "CFileCache::{} - source reopened successfully on attempt {}/{} <{}>",
+                    __FUNCTION__, attempt, MAX_SOURCE_ATTEMPTS, m_sourcePath);
+          return true;
+        }
+
+        CLog::Log(LOGERROR,
+                  "CFileCache::{} - failed to restore source position {} (got {}) <{}>",
+                  __FUNCTION__, m_writePos, seekResult, m_sourcePath);
+      }
+      else
+      {
+        CLog::Log(LOGERROR, "CFileCache::{} - reopened source is not seekable <{}>",
+                  __FUNCTION__, m_sourcePath);
+      }
+    }
+    else
+    {
+      CLog::Log(LOGERROR, "CFileCache::{} - failed to reopen source (attempt {}/{}) <{}>",
+                __FUNCTION__, attempt, MAX_SOURCE_ATTEMPTS, m_sourcePath);
+    }
+
+    m_source.Close();
+
+    if (attempt < MAX_SOURCE_ATTEMPTS)
+    {
+      CLog::Log(LOGWARNING,
+                "CFileCache::{} - waiting {} ms before next reopen attempt <{}>",
+                __FUNCTION__,
+                std::chrono::duration_cast<std::chrono::milliseconds>(retryDelay).count(),
+                m_sourcePath);
+
+      std::this_thread::sleep_for(retryDelay);
+      retryDelay += 1s;
+    }
+  }
+
+  CLog::Log(LOGERROR, "CFileCache::{} - all reopen attempts failed <{}>",
+            __FUNCTION__, m_sourcePath);
+  return false;
+}
