+bool CFileCache::ReopenSource()
+{
+  auto retryDelay = SOURCE_REOPEN_RETRY_DELAY;
+  unsigned int attempt = 0;
+
+  while (!m_bStop)
+  {
+    ++attempt;
+
+    CLog::Log(LOGWARNING,
+              "CFileCache::{} - reopening source at position {} (attempt {}) <{}>",
+              __FUNCTION__, m_writePos, attempt, m_sourcePath);
+
+    // StopThread() waits for the worker thread before Close() can close m_source.
+    // Check the stop state before every source operation so shutdown cannot start
+    // another open/seek attempt after the worker has been asked to exit.
+    if (m_bStop)
+      return false;
+
+    m_source->Close();
+
+    if (m_bStop)
+      return false;
+
+    if (m_source->Open(CURL(m_sourceUrl), READ_NO_CACHE | READ_TRUNCATED | READ_NO_BUFFER))
+    {
+      if (m_bStop)
+      {
+        m_source->Close();
+        return false;
+      }
+
+      m_seekPossible = m_source->IoControl(IOControl::SEEK_POSSIBLE, NULL);
+      if (m_seekPossible)
+      {
+        m_fileSize = m_source->GetLength();
+
+        const auto seekResult = m_source->Seek(m_writePos, SEEK_SET);
+        if (seekResult == m_writePos)
+        {
+          if (m_bStop)
+          {
+            m_source->Close();
+            return false;
+          }
+
+          m_sourcePositionValid = true;
+          CLog::Log(LOGWARNING,
+                    "CFileCache::{} - source reopened successfully on attempt {} <{}>",
+                    __FUNCTION__, attempt, m_sourcePath);
+          return true;
+        }
+
+        CLog::Log(LOGERROR,
+                  "CFileCache::{} - failed to restore source position {} (got {}) <{}>",
+                  __FUNCTION__, m_writePos, seekResult, m_sourcePath);
+      }
+      else
+      {
+        CLog::Log(LOGERROR, "CFileCache::{} - reopened source is not seekable <{}>",
+                  __FUNCTION__, m_sourcePath);
+      }
+    }
+    else
+    {
+      CLog::Log(LOGERROR, "CFileCache::{} - failed to reopen source (attempt {}) <{}>",
+                __FUNCTION__, attempt, m_sourcePath);
+    }
+
+    m_source->Close();
+
+    if (m_bStop)
+      return false;
+
+    CLog::Log(LOGWARNING,
+              "CFileCache::{} - waiting {} ms before next reopen attempt <{}>",
+              __FUNCTION__,
+              std::chrono::duration_cast<std::chrono::milliseconds>(retryDelay).count(),
+              m_sourcePath);
+
+    if (AbortableWait(m_reopenEvent, retryDelay) == WAIT_INTERRUPTED || m_bStop)
+      return false;
+
+    retryDelay += 1s;
+  }
+
+  return false;
+}
